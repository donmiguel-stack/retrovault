# ROMs, the BIOS and manual scans are not ours to distribute. Keep your own
# dumps in these folders; git will not pick them up.
emulator/roms/
emulator/bios/
manuals/
# extras/ is ignored file-by-file (not as a whole directory) so the specific
# exceptions below can still be un-ignored. See those for why.
extras/*
_brazil_staging/

# The BIOS + abandonware ROM set the Vault hosts on retrovault.world (never
# in this repo). tools/make_hosted.py assembles it here for manual upload;
# hosted.js (committed) only carries the URL and the list of filenames.
_hosted/

# Leftover advisory git-lock files (index.lock, HEAD.lock, maintenance.lock
# and their stale/timestamped variants) moved here instead of deleted -
# device_bash (the cloud session's bridge to this Mac) can't unlink files on
# this mounted folder, only move them. Empty junk, never meant to be
# committed; ignored so it stops showing up as changes.
_to_delete/

# Quest for the Rings (Videopac vp_42) is long out of print - without its
# fold-out map and fiches, someone who only has the ROM can't actually play.
# These three are your own reshoot/redraws (not scans of the publisher's
# manual or box), so unlike the rest of extras/ they're meant to ship with
# every clone/download of the Vault, not just live on your own machine.
!extras/quest-for-the-rings-map.jpg
!extras/quest-for-the-rings-map-print-4xA4.pdf
!extras/quest-for-the-rings-fiches-printable.pdf

# Master Strategy Series manuals (Conquest of the World, Quest for the
# Rings, Great Wall Street Fortune Hunt) - unlike the exception above,
# these ARE scans of the publisher's own manuals (sourced from
# odyssey2.info and videopac.ch, see vault-sources.md), not your own work.
# Un-ignored anyway: all three games are 40+ years out of print and no
# longer sold in any form, so there's no active commercial product these
# scans compete with - same abandonware footing already applied to the
# C64/PC shelves elsewhere in this project.
!extras/conquest-of-the-world-manual.pdf
!extras/conquest-of-the-world-manual-de.pdf
!extras/quest-for-the-rings-manual-de.pdf
!extras/great-wall-street-fortune-hunt-manual-multilang.pdf

# 2026-08-13 videopac.ch batch - same abandonware footing as the block
# above (all Videopac/G7000/G7400 carts, decades out of print, no active
# commercial product these compete with). Covers box art variants, board/
# map scans, keyboard overlays and manuals for titles that had none in the
# Vault yet (Verkehrsspiele 1/2 had no manual at all; Computer Programmer's
# old placeholder "manual" replaced with the real thing - see extras.js).
!extras/computer-programmer-manual.pdf
!extras/conquest-of-the-world-map.jpg
!extras/musician-overlay-g7000.jpg
!extras/musician-overlay-g7200.jpg
!extras/quest-for-the-rings-overlay-g7000.jpg
!extras/quest-for-the-rings-overlay-g7200.jpg
!extras/verkehrsspiele-1-manual-de.pdf
!extras/verkehrsspiele-2-manual-de.pdf
!extras/great-wall-street-fortune-hunt-box.jpg
!extras/great-wall-street-fortune-hunt-box-brazil.jpg
!extras/great-wall-street-fortune-hunt-box-odyssey2.jpg

# Cover art set aside rather than deleted - working files, not part of the Vault.
covers/_needs-art/
covers/_replaced/
covers/_withheld/

# Your private link to wherever your dumps live. Never commit this.
sources.local.json

# Personal-only game picks (e.g. still-commercial titles you own but don't
# want listed in the public catalogue/games.js) - a standalone page that
# links straight to emulator/dos.html or emulator/index.html outside the
# normal library, so it never needs a games.js/gamepages.js/genres.js entry
# or public cover art. Same ".local." convention as sources.local.json above.
*.local.html

.DS_Store

# Zips built for handing the Vault to someone else - not part of the repo.
_bundles/

# Marks the authoring copy - updates are refused while this exists.
.authoring

# Making-of material for the YouTube tour. Kept locally: none of it is needed
# to run the Vault, and the subtitles already live on the video itself.
narration/
subtitles/
video-captions.md
video-script.md
video-script-2.txt
youtube-listing.md

# python bytecode
__pycache__/

# Working notes and history - reasoning, open questions, commercial bits.
# Useful locally, not part of what people clone.
WORKLOG.md
missing-videos.md
missing-histories.md

# C64 asset fetcher (tools/fetch_c64_assets.py) working files. The assets it
# pulls land in already-ignored folders (emulator/roms/, extras/); these are
# its scratch + the big cached manual zip.
tools/.cache/
tools/fetch-c64-report.txt
extras.js.bak
# Scraped C64 box art is fair-use and overwrites the generated placeholder
# covers/c64_*.png in place. They're committed by default (as the placeholders
# are); if you'd rather not redistribute the real scans, `git checkout` those
# files before committing, or uncomment the next line.
# covers/c64_*.png

# Social-media clip drafts (Mike's own posts, not part of the app)
social-clips/

# Landing-site source zip (retrovault.world) - deployed manually to Hostinger,
# not part of the vault app itself and doesn't need to ship in this repo.
retrovault-world-site.zip
