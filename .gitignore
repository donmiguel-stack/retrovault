# ROMs, the BIOS and manual scans are not ours to distribute. Keep your own
# dumps in these folders; git will not pick them up.
emulator/roms/
emulator/bios/
manuals/
extras/
_brazil_staging/

# Cover art set aside rather than deleted - working files, not part of the Vault.
covers/_needs-art/
covers/_replaced/
covers/_withheld/

# Your private link to wherever your dumps live. Never commit this.
sources.local.json

.DS_Store

# Zips built for handing the Vault to someone else - not part of the repo.
_bundles/

# Marks the authoring copy - updates are refused while this exists.
.authoring

# Making-of material for the YouTube tour. Kept locally: none of it is needed
# to run the Vault, and the subtitles already live on the video itself.
narration/
subtitles/
video-captions.md
video-script.md
video-script-2.txt
youtube-listing.md

# python bytecode
__pycache__/

# Working notes and history - reasoning, open questions, commercial bits.
# Useful locally, not part of what people clone.
WORKLOG.md
missing-videos.md
missing-histories.md

# C64 asset fetcher (tools/fetch_c64_assets.py) working files. The assets it
# pulls land in already-ignored folders (emulator/roms/, extras/); these are
# its scratch + the big cached manual zip.
tools/.cache/
tools/fetch-c64-report.txt
extras.js.bak
# Scraped C64 box art is fair-use and overwrites the generated placeholder
# covers/c64_*.png in place. They're committed by default (as the placeholders
# are); if you'd rather not redistribute the real scans, `git checkout` those
# files before committing, or uncomment the next line.
# covers/c64_*.png
